# Copia este archivo como .env.local y ajusta los valores.

# Origen de los datos:
#   local -> datos guardados en el navegador (funciona sin backend)
#   api   -> microservicios Spring Boot a través del API Gateway
VITE_MODO_DATOS=local

# URL base de la API (rutas versionadas). Con el proxy de Vite en desarrollo basta con /api/v1.
VITE_API_URL=/api/v1

# Dirección del API Gateway que usa el proxy de Vite en desarrollo (npm run dev).
VITE_PROXY_DESTINO=http://localhost:8080
